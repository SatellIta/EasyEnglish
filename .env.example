# EasyEnglish 本地环境变量示例：复制为 .env 后按需填写。
# 也可以完全不填，启动后在 App 的「设置」页面配置；设置页保存的值优先级更高。
# 使用应用专属变量名，避免误用本机其他工具的 OPENAI_* 配置。

# OpenAI 兼容接口（OpenAI / DeepSeek / 通义千问 / Ollama 等）
EASYENGLISH_BASE_URL=https://api.openai.com/v1
EASYENGLISH_API_KEY=
EASYENGLISH_MODEL=gpt-4o-mini

# 本地服务
PORT=3001
DB_PATH=./data/easy-english.db
